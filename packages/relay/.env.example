# Never commit the real .env. The API token stays server-side only (hard constraint, §9).
TXLINE_API_TOKEN=
# This host must match the network where the API token was activated.
TXLINE_BASE_URL=https://txline-dev.txodds.com
REDIS_URL=redis://localhost:6379
PORT=4000
# "replay" (default, works post-deadline / for judging) or "live"
# Live stream needs an active TxLINE window — post-World Cup, stay on replay.
FEED_MODE=replay
REPLAY_FIXTURE_ID=18237038
# Keep this at 1 for normal gameplay pacing. Higher values are useful for engine
# iteration, but also compress prediction windows and match-event gaps.
REPLAY_SPEED=1
# Optional: skip this many fixture-time ms before starting playback (non-destructive —
# the file itself is untouched). Prefer REPLAY_SKIP_TO_DANGER for demos; only set a
# manual offset when you need a specific point in the fixture.
REPLAY_START_OFFSET_MS=0
# Jump to just before the first confirmed danger/high-danger possession (default on).
# Set false to start at kickoff instead. Ignored when REPLAY_START_OFFSET_MS > 0.
REPLAY_SKIP_TO_DANGER=true
# For FEED_MODE=live only: which fixture to filter the global live stream down to.
LIVE_FIXTURE_ID=18257739
